<?xml version="1.0" encoding="utf-8"?>
<!-- https only, to the system's trusted certificates (Tailscale's are publicly trusted). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
