{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Ledgerly window may do: the basics, and open https / phone / e-mail links in the default app.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "tel:*" }, { "url": "mailto:*" }]
    }
  ]
}
