# Copy to .env and fill in. Never commit .env.

# --- ports on your PC (change if something else already uses them) ----------
APP_PORT=8000
DB_PORT=5432

# --- database ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Used when you run the app or tests from your venv (outside Docker); the port here = DB_PORT:
DATABASE_URL=postgresql+psycopg://loan_tracker:change-me@127.0.0.1:5432/loan_tracker
# Throwaway database for `pytest` (created with createdb, see README):
TEST_DATABASE_URL=postgresql+psycopg://loan_tracker:change-me@127.0.0.1:5432/loan_tracker_test

# --- app --------------------------------------------------------------------
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
APP_TIMEZONE=Asia/Kolkata
# 1 when served over HTTPS (reverse proxy); keeps the login cookie HTTPS-only
SECURE_COOKIES=0
REMINDER_DAYS_BEFORE=3
CONCENTRATION_FLAG_PCT=25
# Mute routine reminders for a book, e.g. PERSONAL (money YOU owe is never muted)
MUTE_BOOKS=

# --- daily job ----------------------------------------------------------------
JOB_TIME=08:00
# Telegram: create a bot with @BotFather, send it a message, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email backup (e.g. Gmail SMTP with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
